# Cliente (Vite) — visibles en el navegador, no son secretos
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional — activa Firebase App Check (protección anti-abuso en el registro).
# Sin esta clave, App Check simplemente no se inicializa (ver src/config/firebase.ts).
VITE_RECAPTCHA_SITE_KEY=

# Servidor (funciones de Vercel en api/) — secretos, solo en Vercel, nunca en el cliente
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_FLOTA=
STRIPE_PRICE_EMPRESA=
# JSON de la cuenta de servicio de Firebase Admin, en base64 (ver FIREBASE_SETUP.md)
FIREBASE_SERVICE_ACCOUNT=
# Emails con acceso a /panel-admin, separados por comas
PLATFORM_ADMIN_EMAILS=
