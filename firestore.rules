rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A disabled profile must lose access immediately, even from a session
    // that is somehow still holding a not-yet-expired ID token — deleting
    // the Firebase Auth account alone does not achieve that (see UserProfile
    // .disabled doc comment), so this check is the actual enforcement point.
    function isMember(companyId) {
      let profile = myProfile();
      return signedIn() && profile.companyId == companyId && profile.get('disabled', false) != true;
    }

    function isAdmin(companyId) {
      return isMember(companyId) && myProfile().role == 'admin';
    }

    // Real (not just UI) enforcement of the free-trial document cap: 10 DeCA
    // total per company (kept in sync by hand with TRIAL_DOC_LIMIT in
    // src/lib/trial.ts — rules can't import that constant), waived entirely
    // once a paid subscription is active or in its Stripe-retry grace period.
    // The trial's 5-day cap is enforced client-side only (see trial.ts) —
    // `createdAt` is stored as an ISO string, not a Firestore Timestamp, so a
    // clean day-boundary check isn't practical here without a schema change.
    function canCreateDeca(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return c.get('subscriptionStatus', '') in ['active', 'past_due'] || c.get('decaCount', 0) < 10;
    }

    // Real enforcement of each plan's team-size cap (kept in sync by hand
    // with PLANS/memberLimitFor in src/lib/plans.ts). A company with no
    // active/grace-period subscription is trial-limited the same as the
    // Básico plan, whether it's mid-trial or its trial has already expired.
    function memberLimit(c) {
      let subscribed = c.get('subscriptionStatus', '') in ['active', 'past_due'];
      let plan = c.get('plan', '');
      return !subscribed ? 3
        : plan == 'basico' ? 3
        : plan == 'flota' ? 10
        : plan == 'empresa' ? 50
        : plan == 'flota_plus' ? 999999
        : 3;
    }
    // Default 0, not 1 — has to match what Firestore's `increment()` itself
    // does to a genuinely missing field (treats it as 0), which is what a
    // company created before `memberCount` existed will have. It undercounts
    // that admin by one until the field starts existing, which only matters
    // for pre-existing test data — every company created going forward
    // always has it explicitly seeded (see companies' `create` rule below).
    function withinMemberLimit(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return c.get('memberCount', 0) < memberLimit(c);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin(resource.data.companyId));

      // Two ways a profile document is created:
      // 1. Self-signup: the first login after the platform admin creates
      //    the Auth account (company-setup flow) — the new user creates
      //    their own doc.
      // 2. A company admin creating a driver/teammate account under their
      //    own company — always role 'member', never 'admin'. Only the
      //    platform admin, via the Firebase console, creates the first
      //    admin of a company (see FIREBASE_SETUP.md).
      allow create: if signedIn() && (
        request.auth.uid == uid ||
        (isAdmin(request.resource.data.companyId) && request.resource.data.role == 'member' &&
         withinMemberLimit(request.resource.data.companyId))
      );

      // An admin may act on a teammate (never on themselves — that's what
      // `uid != request.auth.uid` rules out both times below, which is also
      // what makes it impossible to ever end up with zero admins through
      // this UI: whoever performs the change is necessarily still an admin
      // afterwards), in exactly two shapes:
      // 1. Toggle `disabled`. Disabling always frees a seat, so it's always
      //    allowed; re-enabling uses one again, so it re-checks the plan's
      //    seat limit just like creating a new teammate would.
      // 2. Change `role` between 'admin' and 'member' — doesn't touch the
      //    seat count either way, it's still one active account.
      allow update: if signedIn() && isAdmin(resource.data.companyId) && uid != request.auth.uid && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']) &&
          (request.resource.data.disabled == true || withinMemberLimit(resource.data.companyId))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['admin', 'member'])
      );
      allow delete: if false;
    }

    // A new company can be created by any signed-in user during signup
    // (companyId is a fresh random id chosen client-side) — must include
    // exactly the fields the self-serve signup form collects, nothing more.
    // Billing fields (plan, stripeCustomerId, ...) are added later by a
    // trusted backend via the Admin SDK, which bypasses these rules
    // entirely, so they must never be allowed here. After creation, only an
    // admin may update the company's own basic info (not just any member —
    // a regular driver has no business rewriting the tenant's billing
    // identity), and only those same fields.
    match /companies/{companyId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['id', 'nombre', 'nif', 'domicilio', 'createdAt', 'decaCount', 'memberCount']) &&
        request.resource.data.keys().hasAll(['id', 'nombre', 'nif', 'domicilio', 'createdAt', 'decaCount', 'memberCount']) &&
        request.resource.data.id == companyId &&
        request.resource.data.decaCount == 0 &&
        request.resource.data.memberCount == 1;
      allow read: if isMember(companyId);
      allow update: if isAdmin(companyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'nif', 'domicilio']);
      // Any member (not just the admin) may bump their own company's DeCA
      // counter — it's written in the same batch as each new decaDoc, by
      // whichever team member (driver or admin) is generating it, and only
      // ever by exactly 1 at a time.
      allow update: if isMember(companyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decaCount']) &&
        request.resource.data.decaCount == resource.data.get('decaCount', 0) + 1;
      // The team-seat counter, on the other hand, only ever changes as a
      // side effect of an admin action (creating, disabling or re-enabling a
      // teammate — see the matching writeBatch calls in teamService.ts), so
      // only an admin may move it, by exactly 1 in either direction.
      allow update: if isAdmin(companyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        (request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1 ||
         request.resource.data.memberCount == resource.data.get('memberCount', 0) - 1);
      allow delete: if false;

      match /decaDocs/{docId} {
        // Admins see every DeCA the company has ever issued; a regular team
        // member (driver) only ever sees the ones they created themselves.
        allow read: if isMember(companyId) &&
          (isAdmin(companyId) || resource.data.createdBy == request.auth.uid);
        allow create: if isMember(companyId) && request.resource.data.createdBy == request.auth.uid &&
          canCreateDeca(companyId);
        // Only `status`/`supersededBy` (correction flow) and `hidden`
        // (show/hide from the history view) may change after creation — the
        // legal document data itself must never be edited once generated,
        // and it can never be deleted (DeCA must stay retrievable for the
        // legally required 1-year retention period). Only the document's own
        // creator or an admin may touch even those fields.
        allow update: if isMember(companyId) &&
          (isAdmin(companyId) || resource.data.createdBy == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hidden', 'supersededBy']);
        allow delete: if false;
      }

      // Saved trip presets (recurring counterpart/mercancía/ruta) are pure
      // user convenience, not legal document data — unlike decaDocs, any
      // member can freely create, edit or delete their company's own, with
      // no field-level lock.
      match /savedTrips/{tripId} {
        allow read, create, update, delete: if isMember(companyId);
      }
    }
  }
}
